# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Gemini (aistudio.google.com/apikey). Se usa tanto para transcribir como para escribir los guiones
# (incluye Google Search para la investigación de los UGC).
GEMINI_API_KEY=AI...
# Modelo de Gemini. Revisa en aistudio.google.com cuál está vigente; gemini-2.5-pro da mejor calidad
# a más costo si gemini-2.5-flash se queda corto.
GEMINI_MODEL=gemini-2.5-flash

# Precios para estimar el costo por guion (USD por millón de tokens, y por búsqueda). Ajusta a los
# precios vigentes de Gemini en ai.google.dev/pricing.
PRECIO_ENTRADA_MILLON=0.3
PRECIO_SALIDA_MILLON=2.5
PRECIO_BUSQUEDA=0.035
