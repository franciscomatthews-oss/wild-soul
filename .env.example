# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Anthropic (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=sk-ant-...
# Modelo para escribir guiones. Revisa el nombre vigente en la documentación de Anthropic.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Versión de la herramienta de búsqueda web de Anthropic (solo UGC)
ANTHROPIC_WEB_SEARCH_TOOL=web_search_20250305

# OpenAI (platform.openai.com > API keys)
OPENAI_API_KEY=sk-...
# Modelo de transcripción. Revisa cuál está vigente en la documentación de OpenAI.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Precios para estimar el costo por guion (USD). Ajusta a los precios vigentes.
PRECIO_ENTRADA_MILLON=2
PRECIO_SALIDA_MILLON=10
PRECIO_BUSQUEDA=0.01
PRECIO_MINUTO_AUDIO=0.006
